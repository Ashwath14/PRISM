<Window x:Class="PRISM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PRISM.App"
        xmlns:views="clr-namespace:PRISM.App.Views"
        mc:Ignorable="d"
        Title="PRISM — Premium Display &amp; Audio Studio" 
        Height="800" Width="1240"
        MinHeight="700" MinWidth="1080"
        Icon="Assets/PRISM.ico"
        Background="{StaticResource PrismCanvasBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Deep Ambient Radial Glow Background spanning both columns -->
        <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Fill="{StaticResource WindowAmbientGlow}" IsHitTestVisible="False" />

        <!-- ========================================================= -->
        <!-- LEFT NAVIGATION SIDEBAR                                   -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="{StaticResource PrismSidebarBrush}" 
                BorderBrush="{StaticResource PrismBorderSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. PRISM Brand Header & Refractive 'P' Logo -->
                <StackPanel Grid.Row="0" Margin="4,0,0,28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Squircle Optical Refraction Logo -->
                        <Border Width="34" Height="34" CornerRadius="10" 
                                Background="{StaticResource CyanAccentGradient}" Margin="0,0,12,0">
                            <Path Data="{StaticResource PrismLogoGeometry}" Fill="#080C14" 
                                  Width="18" Height="18" Stretch="Uniform" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PRISM" FontSize="18" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="STUDIO" FontSize="9" FontWeight="SemiBold" 
                                       Foreground="{StaticResource ElectricCyanBrush}" Margin="1,-2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 2. Section Header -->
                <TextBlock Grid.Row="1" Text="STUDIO NAVIGATION" FontSize="10" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextTertiaryBrush}" Margin="8,0,0,10" />

                <!-- 3. Navigation Items -->
                <StackPanel Grid.Row="2">
                    <!-- Home -->
                    <RadioButton GroupName="NavGroup" Style="{StaticResource PrismNavButtonStyle}" 
                                 IsChecked="{Binding IsHomeSelected, Mode=TwoWay}" 
                                 Command="{Binding NavigateCommand}" CommandParameter="Home">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource HomeIconGeometry}" 
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Text="Home" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Display Studio -->
                    <RadioButton GroupName="NavGroup" Style="{StaticResource PrismNavButtonStyle}" 
                                 IsChecked="{Binding IsDisplaySelected, Mode=TwoWay}" 
                                 Command="{Binding NavigateCommand}" CommandParameter="Display">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DisplayIconGeometry}" 
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Text="Display Studio" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Audio Studio -->
                    <RadioButton GroupName="NavGroup" Style="{StaticResource PrismNavButtonStyle}" 
                                 IsChecked="{Binding IsAudioSelected, Mode=TwoWay}" 
                                 Command="{Binding NavigateCommand}" CommandParameter="Audio">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource AudioIconGeometry}" 
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Text="Audio Studio" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Environments -->
                    <RadioButton GroupName="NavGroup" Style="{StaticResource PrismNavButtonStyle}" 
                                 IsChecked="{Binding IsEnvironmentsSelected, Mode=TwoWay}" 
                                 Command="{Binding NavigateCommand}" CommandParameter="Environments">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource EnvironmentIconGeometry}" 
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Text="Environments" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Settings -->
                    <RadioButton GroupName="NavGroup" Style="{StaticResource PrismNavButtonStyle}" 
                                 IsChecked="{Binding IsSettingsSelected, Mode=TwoWay}" 
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SettingsIconGeometry}" 
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Diagnostics -->
                    <RadioButton GroupName="NavGroup" Style="{StaticResource PrismNavButtonStyle}" 
                                 IsChecked="{Binding IsDiagnosticsSelected, Mode=TwoWay}" 
                                 Command="{Binding NavigateCommand}" CommandParameter="Diagnostics">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ActivityIconGeometry}" 
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Text="Diagnostics" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 4. Ambient Sidebar Glow Mesh -->
                <Border Grid.Row="3" Height="40" Background="Transparent" />
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- RIGHT MAIN CONTENT VIEWPORT + PERSISTENT BOTTOM DOCK      -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Active Viewport Host (Direct ContentControl; views manage their own clean scrolling) -->
            <ContentControl Grid.Row="0" Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type local:ViewModels.HomeViewModel}">
                        <views:HomeView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:ViewModels.DisplayStudioViewModel}">
                        <views:DisplayStudioView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:ViewModels.AudioStudioViewModel}">
                        <views:AudioStudioView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:ViewModels.EnvironmentsViewModel}">
                        <views:EnvironmentsView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:ViewModels.SettingsViewModel}">
                        <views:SettingsView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <!-- 2. Global Persistent Bottom Status Bar (Matching Reference 2) -->
            <Border Grid.Row="1" Background="{StaticResource SurfacePrimaryBrush}" 
                    BorderBrush="{StaticResource PrismBorderSubtleBrush}" BorderThickness="0,1,0,0" 
                    Height="44" Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: System Ready with Glowing Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessGreenBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#63C99A" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="System Ready" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="All services are running normally." FontSize="11" 
                                   Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center: Device & Environment Indicators -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Display -->
                        <Path Data="{StaticResource DisplayIconGeometry}" Fill="{StaticResource TextMutedBrush}" 
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Display: " FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DisplayStatusText}" FontSize="11.5" FontWeight="SemiBold" 
                                   Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center" />

                        <Rectangle Width="1" Height="14" Fill="{StaticResource PrismBorderSubtleBrush}" Margin="18,0" VerticalAlignment="Center" />

                        <!-- Audio -->
                        <Path Data="{StaticResource SpeakerIconGeometry}" Fill="{StaticResource TextMutedBrush}" 
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Audio: " FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AudioStatusText}" FontSize="11.5" FontWeight="SemiBold" 
                                   Foreground="{StaticResource AudioAccentBrush}" VerticalAlignment="Center" />

                        <Rectangle Width="1" Height="14" Fill="{StaticResource PrismBorderSubtleBrush}" Margin="18,0" VerticalAlignment="Center" />

                        <!-- Environment -->
                        <Path Data="{StaticResource EnvironmentIconGeometry}" Fill="{StaticResource TextMutedBrush}" 
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Environment: " FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveEnvironmentName}" FontSize="11.5" FontWeight="SemiBold" 
                                   Foreground="{StaticResource AudioAccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: Version & Quick Flyout/Info Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppVersionText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" 
                                   Margin="0,0,10,0" VerticalAlignment="Center" />
                        <!-- Info / Diagnostics Button -->
                        <Button Style="{StaticResource PrismIconButtonStyle}" Command="{Binding OpenDiagnosticsCommand}" 
                                ToolTip="View Diagnostics &amp; Telemetry" Width="26" Height="26" Margin="0,0,6,0">
                            <Path Data="{StaticResource InfoIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                        <!-- Quick Flyout Button -->
                        <Button Style="{StaticResource PrismIconButtonStyle}" Click="OnFlyoutButtonClick" 
                                ToolTip="Launch Quick Flyout (Win+Alt+P)" Width="26" Height="26">
                            <Path Data="{StaticResource ExternalLinkIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
