<UserControl x:Class="PRISM.App.Views.EnvironmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="1100" d:DesignWidth="980">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="OnPreviewMouseWheel">
    <Grid Margin="36,28,36,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- ROW 0: HEADER & MANAGEMENT ACTIONS                        -->
        <!-- ========================================================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Environments" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="One-click profiles that sync display, audio and system settings." 
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrismPrimaryButtonStyle}" Height="34" Padding="14,0" 
                        Command="{Binding CreateEnvironmentFromCurrentStateCommand}" Margin="0,0,8,0">
                    <TextBlock Text="+ Save Current State" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="34" Padding="12,0" 
                        Content="Duplicate" Command="{Binding DuplicateEnvironmentCommand}" Margin="0,0,8,0" FontSize="11" />
                <Button Style="{StaticResource PrismWarningButtonStyle}" Height="34" Padding="12,0" 
                        Content="Restore Defaults" Command="{Binding RestoreDefaultEnvironmentsCommand}" FontSize="11" />
            </StackPanel>
        </Grid>

        <!-- Spacer -->
        <Border Grid.Row="1" />

        <!-- ========================================================= -->
        <!-- ROW 2: FEEDBACK & TELEMETRY TOAST BANNER                  -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Style="{StaticResource PrismElevatedCardStyle}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Data="{StaticResource InfoIconGeometry}" Fill="{StaticResource ElectricCyanBrush}" 
                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Engine Status: " FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding StatusFeedback}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Active Preset Badge -->
                <Border Grid.Column="2" Style="{StaticResource PrismStatusChipStyle}" 
                        Background="#1A00C7FF" BorderBrush="#3300C7FF" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedPreset.Name, StringFormat='Active Mode: {0}'}" FontSize="10" 
                               FontWeight="SemiBold" Foreground="{StaticResource ElectricCyanBrush}" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Spacer -->
        <Border Grid.Row="3" />

        <!-- ========================================================= -->
        <!-- ROW 4: ENVIRONMENT INSPECTOR (PREVIEW & VERIFICATION DECK) -->
        <!-- ========================================================= -->
        <Border Grid.Row="4" Style="{StaticResource PrismElevatedCardStyle}" Padding="20,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Inspector Title & Actions -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Path Data="{StaticResource SlidersIconGeometry}" Fill="{StaticResource ElectricCyanBrush}" 
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="ENVIRONMENT INSPECTOR" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <Border Visibility="{Binding IsPreviewingDifferent, Converter={StaticResource BoolToVisConverter}}"
                                    Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="6"
                                    Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PREVIEW MODE — HARDWARE UNAFFECTED" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PreviewedPreset.Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text=" — " FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PreviewedPreset.Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Inspector Apply Mode Button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrismPrimaryButtonStyle}" Height="34" Padding="18,0"
                                Command="{Binding ApplyEnvironmentCommand}"
                                CommandParameter="{Binding PreviewedPreset}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource CheckIconGeometry}" Fill="#050811" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Apply Mode to Hardware" FontSize="11" FontWeight="Bold" Foreground="#050811" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Inspector Content: Display Parameters & Mini EQ Curve -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>

                    <!-- Display Parameters Box -->
                    <Border Grid.Column="0" Background="#101827" BorderBrush="{StaticResource PrismBorderSubtleBrush}" 
                            BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="{StaticResource DisplayIconGeometry}" Fill="{StaticResource ElectricCyanBrush}" 
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="DISPLAY HARDWARE TARGETS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" />
                            </StackPanel>

                            <!-- Luminance & Contrast -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Target Luminance" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding PreviewedPreset.DisplaySettings.Brightness, StringFormat='{}{0}%'}" 
                                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource ElectricCyanBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Target Contrast" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding PreviewedPreset.DisplaySettings.Contrast, StringFormat='{}{0}%'}" 
                                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- RGB Gain Calibration -->
                            <TextBlock Text="RGB Color Calibration Gain:" FontSize="9.5" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,3" />
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#1A00C7FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding PreviewedPreset.DisplaySettings.RedGain, StringFormat='{}R: {0}%'}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                                </Border>
                                <Border Background="#1A10B981" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding PreviewedPreset.DisplaySettings.GreenGain, StringFormat='{}G: {0}%'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}" />
                                </Border>
                                <Border Background="#1A818CF8" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding PreviewedPreset.DisplaySettings.BlueGain, StringFormat='{}B: {0}%'}" FontSize="10" FontWeight="SemiBold" Foreground="#818CF8" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Audio Profile & Dynamic Mini EQ Curve -->
                    <Border Grid.Column="2" Background="#101827" BorderBrush="{StaticResource PrismBorderSubtleBrush}" 
                            BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Path Data="{StaticResource HeadphonesIconGeometry}" Fill="{StaticResource AudioAccentBrush}" 
                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="ACOUSTIC DSP PROFILE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding PreviewedPreset.AudioSettings.Name}" FontSize="15" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding PreviewedPreset.AudioSettings.Category}" FontSize="10" 
                                           Foreground="{StaticResource AudioAccentBrush}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding PreviewedPreset.AudioSettings.Description}" FontSize="11" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Embedded Dynamic Mini EQ Curve -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                                <Border Background="#0C121E" BorderBrush="{StaticResource PrismBorderSubtleBrush}" 
                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                    <StackPanel>
                                        <TextBlock Text="10-BAND RESPONSE" FontSize="8.5" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                        <Path Data="{Binding PreviewMiniCurvePath}" Stroke="{StaticResource AudioAccentBrush}" 
                                              StrokeThickness="2" Height="32" Width="120" Stretch="Fill" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Spacer -->
        <Border Grid.Row="5" />

        <!-- ========================================================= -->
        <!-- ROW 6: DAY/NIGHT AUTOMATION & SCHEDULE                    -->
        <!-- ========================================================= -->
        <Border Grid.Row="6" Style="{StaticResource PrismCardStyle}" Padding="20,16">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SunIconGeometry}" Fill="{StaticResource ElectricCyanBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="DAY / NIGHT AUTOMATION &amp; CIRCADIAN SCHEDULE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ManualOverrideStatus}" FontSize="11" Foreground="{StaticResource ElectricCyanBrush}" Margin="22,3,0,0" />
                    </StackPanel>

                    <!-- Schedule Enable Toggle & Resume Button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="28" Padding="10,0" Margin="0,0,12,0"
                                Content="Resume Schedule" Command="{Binding ResumeScheduleCommand}"
                                ToolTip="Clear manual override and sync to current time window" />
                        <CheckBox Style="{StaticResource PrismToggleSwitchStyle}" IsChecked="{Binding IsScheduleEnabled, Mode=TwoWay}" ToolTip="Enable automatic day/night switching" />
                    </StackPanel>
                </Grid>

                <!-- Schedule Details & Timers -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Day Window -->
                    <Border Grid.Column="0" Background="#1A080C14" BorderBrush="{StaticResource PrismBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="DAY WINDOW START (24H)" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DayStartTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="{Binding DayPresetName, StringFormat='Mode: {0}'}" FontSize="10" Foreground="{StaticResource ElectricCyanBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Night Window -->
                    <Border Grid.Column="2" Background="#1A080C14" BorderBrush="{StaticResource PrismBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="NIGHT WINDOW START (24H)" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NightStartTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="{Binding NightPresetName, StringFormat='Mode: {0}'}" FontSize="10" Foreground="{StaticResource AudioAccentBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Fullscreen Pause Checkbox -->
                    <Border Grid.Column="4" Background="#1A080C14" BorderBrush="{StaticResource PrismBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource PrismToggleStyle}" IsChecked="{Binding PauseDuringFullscreen, Mode=TwoWay}">
                            <TextBlock Text="Pause During Fullscreen Gaming / Media" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </CheckBox>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Spacer -->
        <Border Grid.Row="7" />

        <!-- ========================================================= -->
        <!-- ROW 8: PHOTOGRAPHIC ATMOSPHERIC ENVIRONMENT CARDS        -->
        <!-- ========================================================= -->
        <ItemsControl Grid.Row="8" ItemsSource="{Binding Presets}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PrismCardStyle}" Margin="0,0,0,16" Padding="0" CornerRadius="16" Height="170">
                        <Grid>
                            <!-- Photographic Atmosphere Background Image -->
                            <Border CornerRadius="16">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,908,170" RadiusX="16" RadiusY="16" />
                                </Border.Clip>
                                <Grid>
                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.38" />
                                    <!-- Smoked Dark Glass Gradient Overlay for Perfect Contrast -->
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#F0090F1B" Offset="0.0" />
                                                <GradientStop Color="#D0090F1B" Offset="0.55" />
                                                <GradientStop Color="#80090F1B" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Card Interactive Foreground Content -->
                            <Grid Margin="22,18,22,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Details -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />

                                        <!-- Active Glow Badge -->
                                        <Border Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}" 
                                                Style="{StaticResource PrismStatusChipStyle}" Background="#2210B981" 
                                                BorderBrush="#5510B981" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="ACTIVE" FontSize="9.5" FontWeight="Bold" 
                                                           Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Custom Badge -->
                                        <Border Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisConverter}}" 
                                                Style="{StaticResource PrismStatusChipStyle}" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="CUSTOM" FontSize="9.5" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" 
                                               Margin="0,0,0,12" TextWrapping="Wrap" />

                                    <!-- Hardware Parameter Chips -->
                                    <WrapPanel Orientation="Horizontal">
                                        <Border Background="#260C1424" BorderBrush="{StaticResource PrismBorderSubtleBrush}" 
                                                BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource SunIconGeometry}" Fill="{StaticResource ElectricCyanBrush}" 
                                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplaySettings.Brightness, StringFormat='{}Luminance: {0}%'}" 
                                                           FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ElectricCyanBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#260C1424" BorderBrush="{StaticResource PrismBorderSubtleBrush}" 
                                                BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,4">
                                            <TextBlock Text="{Binding DisplaySettings.Contrast, StringFormat='{}Contrast: {0}%'}" 
                                                       FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>

                                        <Border Background="#260C1424" BorderBrush="{StaticResource PrismBorderSubtleBrush}" 
                                                BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,4">
                                            <TextBlock Text="{Binding DisplaySettings.RedGain, StringFormat='{}RGB: {0}/{1}/{2}'}" 
                                                       FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" />
                                        </Border>

                                        <Border Background="#260C1424" BorderBrush="{StaticResource PrismBorderSubtleBrush}" 
                                                BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource HeadphonesIconGeometry}" Fill="{StaticResource AudioAccentBrush}" 
                                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding AudioSettings.Name, StringFormat='{}Audio: {0}'}" 
                                                           FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AudioAccentBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Right: Preview & Apply Buttons -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Style="{StaticResource PrismSecondaryButtonStyle}" Content="Inspect Preview" 
                                            Height="36" Padding="14,0" Margin="0,0,10,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.PreviewEnvironmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Inspect environment settings without applying to hardware" />

                                    <Button Style="{StaticResource PrismPrimaryButtonStyle}" Content="Apply Mode" 
                                            Height="36" Padding="18,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.ApplyEnvironmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Apply these unified display &amp; audio settings to hardware" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
    </ScrollViewer>
</UserControl>