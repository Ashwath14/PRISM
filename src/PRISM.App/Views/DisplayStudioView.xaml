<UserControl x:Class="PRISM.App.Views.DisplayStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="1100" d:DesignWidth="980">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"
                  PreviewMouseWheel="OnPreviewMouseWheel">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0: Page Title Header -->
                <RowDefinition Height="Auto" /> <!-- 1: Monitor Identity Card -->
                <RowDefinition Height="Auto" /> <!-- 2: Rollback Safety Banner -->
                <RowDefinition Height="Auto" /> <!-- 3: Resolution & Advanced Color -->
                <RowDefinition Height="Auto" /> <!-- 4: Hardware DDC/CI & RGB/SubZero -->
                <RowDefinition Height="Auto" /> <!-- 5: Display Profiles -->
                <RowDefinition Height="Auto" /> <!-- 6: Diagnostics Drawer -->
            </Grid.RowDefinitions>

            <!-- ========================================================= -->
            <!-- ROW 0: PAGE TITLE HEADER                                  -->
            <!-- ========================================================= -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Display Studio" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="Calibrate and control your display for the best visual experience." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- ========================================================= -->
            <!-- ROW 1: MONITOR IDENTITY HEADER & STATUS BAR               -->
            <!-- ========================================================= -->
            <Border Grid.Row="1" Style="{StaticResource PrismElevatedCardStyle}" Padding="18,14" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Monitor Visual Thumbnail -->
                    <Border Grid.Column="0" Width="68" Height="52" CornerRadius="8" Margin="0,0,16,0" 
                            Background="#101722" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <Grid>
                            <Border CornerRadius="6" Margin="3,3,3,10" Background="#0A111E">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,60,38" RadiusX="4" RadiusY="4" />
                                </Border.Clip>
                                <Image Source="pack://application:,,,/PRISM;component/Assets/Environments/daylight_focus.jpg" 
                                       Stretch="UniformToFill" Opacity="0.8" />
                            </Border>
                            <Rectangle Width="14" Height="7" Fill="#343E4C" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,3" RadiusX="1" RadiusY="1" />
                            <Rectangle Width="26" Height="2" Fill="#4B5563" VerticalAlignment="Bottom" HorizontalAlignment="Center" RadiusX="1" RadiusY="1" />
                        </Grid>
                    </Border>

                    <!-- Monitor Identity Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding SelectedMonitorName}" FontSize="16" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource PrismStatusChipStyle}" Background="#1A63C99A" 
                                    BorderBrush="#3363C99A" Margin="12,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Direct hardware register write verified via I2C / DDC/CI">
                                <TextBlock Text="DDC/CI Verified ●" FontSize="10" FontWeight="SemiBold" 
                                           Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center" />
                            </Border>
                            <Border Style="{StaticResource PrismStatusChipStyle}" Background="#1A76C7C0" 
                                    BorderBrush="#3376C7C0" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="HARDWARE ENGINE" FontSize="10" FontWeight="Bold" 
                                           Foreground="{StaticResource DisplayAccentBrush}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MonitorDetails}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding SerialNumberText}" FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding PreferenceSavedMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Actions: Read Hardware, Save Monitor Defaults & Reset -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="34" Padding="14,0" 
                                Command="{Binding SaveAsDefaultPreferencesCommand}" Margin="0,0,8,0"
                                ToolTip="Remember current brightness, contrast, and RGB gains as default for this specific monitor">
                            <TextBlock Text="Remember Defaults" FontSize="12" FontWeight="Medium" 
                                       Foreground="{StaticResource DisplayAccentBrush}" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="34" Padding="14,0" 
                                Command="{Binding RefreshHardwareCommand}" Margin="0,0,8,0"
                                ToolTip="Query hardware DDC/CI registers directly from monitor scaler MCU">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource RefreshIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Read Hardware" FontSize="12" FontWeight="Medium" 
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrismWarningButtonStyle}" Height="34" Padding="12,0" 
                                Command="{Binding ResetDisplaySettingsCommand}"
                                ToolTip="Reset all monitor settings (Luminance 50%, Contrast 50%, RGB 50/50/50, Native 1920x1080 @ 200Hz)">
                            <TextBlock Text="Reset Defaults" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource WarningAmberBrush}" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- ROW 2: 15-SECOND AUTO-ROLLBACK SAFETY BANNER             -->
            <!-- ========================================================= -->
            <Border Grid.Row="2" Style="{StaticResource PrismCardStyle}" 
                    Background="#263B1010" BorderBrush="#CCEF4444" BorderThickness="1.5"
                    Padding="18,14" Margin="0,0,0,18"
                    Visibility="{Binding IsRollbackBannerVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Data="{StaticResource WarningIconGeometry}" Fill="#EF4444" 
                          Width="22" Height="22" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Confirm Display Mode Change" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="{Binding RollbackBannerText}" FontSize="12" Foreground="#CBD5E1" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrismPrimaryButtonStyle}" Height="32" Padding="14,0"
                                Command="{Binding ConfirmModeCommand}" Margin="0,0,8,0">
                            <TextBlock Text="Keep Changes" FontSize="11" FontWeight="Bold" />
                        </Button>
                        <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="32" Padding="14,0"
                                Command="{Binding RevertModeCommand}">
                            <TextBlock Text="{Binding RollbackCountdownSeconds, StringFormat='{}Revert ({0}s)'}" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- ROW 3: RESOLUTION MANAGEMENT & ADVANCED COLOR ENGINE      -->
            <!-- ========================================================= -->
            <Grid Grid.Row="3" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Dedicated Resolution & Refresh Rate Management -->
                <Border Grid.Column="0" Style="{StaticResource PrismCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="RESOLUTION &amp; REFRESH RATE" FontSize="12" FontWeight="Bold" 
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding CurrentModeSummary}" FontSize="12" 
                                           Foreground="{StaticResource DisplayAccentBrush}" Margin="0,3,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Style="{StaticResource PrismStatusChipStyle}" 
                                    Background="#1A76C7C0" BorderBrush="#3376C7C0" VerticalAlignment="Top">
                                <TextBlock Text="WIN32 CCD" FontSize="10" FontWeight="Bold" 
                                           Foreground="{StaticResource DisplayAccentBrush}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- Resolution Selector -->
                        <TextBlock Text="Display Resolution (Width × Height)" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource PrismComboBoxStyle}" 
                                  ItemsSource="{Binding AvailableResolutions}" 
                                  SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" 
                                  ToolTip="Select from supported physical and GPU-scaled display resolutions"
                                  Margin="0,0,0,12" />

                        <!-- Refresh Rate Selector -->
                        <TextBlock Text="Refresh Rate (Hz • Frames Per Second)" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource PrismComboBoxStyle}" 
                                  ItemsSource="{Binding AvailableRefreshRates}" 
                                  SelectedItem="{Binding SelectedRefreshRate, Mode=TwoWay}" 
                                  ToolTip="Supported display refresh rates for the selected resolution"
                                  Margin="0,0,0,16" />

                        <!-- Action Buttons & Rollback Guard Note -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Style="{StaticResource PrismPrimaryButtonStyle}" Height="34" Padding="16,0" 
                                        Command="{Binding ApplyResolutionCommand}" Margin="0,0,8,0">
                                    <TextBlock Text="Apply Mode" FontSize="12" FontWeight="SemiBold" 
                                               Foreground="#0D1117" VerticalAlignment="Center" />
                                </Button>
                                <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="34" Padding="12,0" 
                                        Command="{Binding ResetDisplayModeToDefaultCommand}" ToolTip="Reverts immediately to native panel resolution (1920x1080 @ 200Hz)">
                                    <TextBlock Text="Reset to Native" FontSize="11" FontWeight="Medium" 
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Protected with 15s auto-rollback" FontSize="11" 
                                       Foreground="{StaticResource TextTertiaryBrush}" 
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right: Windows Advanced Color & HDR Engine -->
                <Border Grid.Column="2" Style="{StaticResource PrismCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="WINDOWS ADVANCED COLOR &amp; HDR" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding HdrStatusBadge}" FontSize="11" 
                                           Foreground="{StaticResource DisplayAccentBrush}" Margin="0,2,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="26" Padding="10,0" 
                                    Content="Query HDR" Command="{Binding ToggleHdrCommand}" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" />
                        </Grid>

                        <!-- Color Specs Grid -->
                        <Border Background="#121826" BorderBrush="{StaticResource PrismBorderSubtleBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Color Depth:" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BitsPerChannel, StringFormat='{}{0}-bit per channel (16.7M Colors)'}" 
                                           FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Pixel Format:" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ColorEncodingText}" 
                                           FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="ICC Profile:" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IccProfilePath}" 
                                           FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <!-- Dolby Vision & Panel Honesty Note -->
                        <TextBlock Text="{Binding DolbyVisionStatus}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" LineHeight="14" />
                        <TextBlock Text="{Binding HdrStatusDescription}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="14" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========================================================= -->
            <!-- ROW 4: DUAL CORE MODULES (DDC/CI HARDWARE & SUB-ZERO)     -->
            <!-- ========================================================= -->
            <Grid Grid.Row="4" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Physical Hardware DDC/CI Controls -->
                <Border Grid.Column="0" Style="{StaticResource PrismCardStyle}">
                    <StackPanel>
                        <!-- Header with HARDWARE DDC/CI Badge -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="HARDWARE DDC/CI CONTROLS" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                <TextBlock Text="Direct register writes to monitor scaler MCU via DisplayPort" 
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Style="{StaticResource PrismStatusChipStyle}" 
                                    Background="#1A76C7C0" BorderBrush="#3376C7C0" VerticalAlignment="Top">
                                <TextBlock Text="HARDWARE DDC/CI" FontSize="9" FontWeight="Bold" 
                                           Foreground="{StaticResource DisplayAccentBrush}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- 1. Luminance (VCP 0x10) -->
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource SunIconGeometry}" Fill="{StaticResource DisplayAccentBrush}" 
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Hardware Luminance (VCP 0x10)" FontSize="12" FontWeight="Medium" 
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Brightness, StringFormat='{}{0}%'}" FontSize="13" FontWeight="Bold" 
                                       Foreground="{StaticResource DisplayAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Style="{StaticResource PrismSliderStyle}" Minimum="0" Maximum="100" 
                                Value="{Binding Brightness, Mode=TwoWay}" Margin="0,0,0,18" />

                        <!-- 2. Contrast (VCP 0x12) -->
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource ContrastIconGeometry}" Fill="{StaticResource DisplayAccentBrush}" 
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Hardware Contrast (VCP 0x12)" FontSize="12" FontWeight="Medium" 
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Contrast, StringFormat='{}{0}%'}" FontSize="13" FontWeight="Bold" 
                                       Foreground="{StaticResource DisplayAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Style="{StaticResource PrismSliderStyle}" Minimum="0" Maximum="100" 
                                Value="{Binding Contrast, Mode=TwoWay}" Margin="0,0,0,14" />

                        <!-- Telemetry Wire Latency Strip -->
                        <Border Background="#1A080C14" BorderBrush="{StaticResource PrismBorderSubtleBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <Grid>
                                <TextBlock Text="{Binding LatencyText}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Bus Pacing: 50 ms Debounced" FontSize="10" FontWeight="SemiBold" 
                                           Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right Column: RGB Color Balance & Sub-Zero Dimmer -->
                <StackPanel Grid.Column="2">
                    <!-- RGB Color Gain Card -->
                    <Border Style="{StaticResource PrismCardStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="RGB HARDWARE GAINS" FontSize="11" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding ApproxColorProfileText}" FontSize="11" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="26" Padding="8,0" 
                                            Content="Warm" Command="{Binding SetWarmGainPresetCommand}" Margin="0,0,4,0" FontSize="10" />
                                    <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="26" Padding="8,0" 
                                            Content="Neutral" Command="{Binding SetNeutralGainPresetCommand}" Margin="0,0,4,0" FontSize="10" />
                                    <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="26" Padding="8,0" 
                                            Content="Cool" Command="{Binding SetCoolGainPresetCommand}" FontSize="10" />
                                </StackPanel>
                            </Grid>

                            <!-- Red Gain -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Red Gain (VCP 0x16)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding RedGain, StringFormat='{}{0}'}" FontSize="11" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Style="{StaticResource PrismSliderStyle}" Minimum="0" Maximum="100" Value="{Binding RedGain, Mode=TwoWay}" Margin="0,0,0,10" />

                            <!-- Green Gain -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Green Gain (VCP 0x18)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding GreenGain, StringFormat='{}{0}'}" FontSize="11" FontWeight="Bold" Foreground="#63C99A" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Style="{StaticResource PrismSliderStyle}" Minimum="0" Maximum="100" Value="{Binding GreenGain, Mode=TwoWay}" Margin="0,0,0,10" />

                            <!-- Blue Gain -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Blue Gain (VCP 0x1A)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding BlueGain, StringFormat='{}{0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DisplayAccentBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Style="{StaticResource PrismSliderStyle}" Minimum="0" Maximum="100" Value="{Binding BlueGain, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Sub-Zero Software Dimmer Card -->
                    <Border Style="{StaticResource PrismCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="SUB-ZERO SOFTWARE DIMMING" FontSize="11" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                    <TextBlock Text="Alpha layered window below 0% hardware minimum" FontSize="11" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource PrismToggleSwitchStyle}" 
                                          IsChecked="{Binding IsSubZeroEnabled, Mode=TwoWay}" 
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Software Dim Level" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding SubZeroPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" 
                                           Foreground="{StaticResource DisplayAccentBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Style="{StaticResource PrismSliderStyle}" Minimum="0" Maximum="80" 
                                    Value="{Binding SubZeroPercent, Mode=TwoWay}" IsEnabled="{Binding IsSubZeroEnabled}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ========================================================= -->
            <!-- ROW 5: DISPLAY PROFILES STUDIO                             -->
            <!-- ========================================================= -->
            <Border Grid.Row="5" Style="{StaticResource PrismCardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <!-- Header & Top Actions -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DISPLAY PROFILES STUDIO" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <Border Style="{StaticResource PrismStatusChipStyle}" Background="#1A76C7C0" BorderBrush="#3376C7C0" Padding="8,3" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource DisplayAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveProfileName, StringFormat='{}Active: {0}'}" FontSize="11" 
                                               FontWeight="SemiBold" Foreground="{StaticResource DisplayAccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Profile Management Toolbar -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="28" Padding="12,0" 
                                    Content="+ Save Current" Command="{Binding SaveCurrentAsCustomProfileCommand}" Margin="0,0,8,0" FontSize="11"
                                    ToolTip="Save current hardware slider values as a new custom profile" />
                            <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="28" Padding="12,0" 
                                    Content="Import" Command="{Binding ImportProfileCommand}" Margin="0,0,8,0" FontSize="11" 
                                    ToolTip="Import .prism-disp display profile" />
                            <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="28" Padding="12,0" 
                                    Content="Restore Defaults" Command="{Binding RestoreDefaultsCommand}" FontSize="11" 
                                    ToolTip="Reset profiles to factory defaults" />
                        </StackPanel>
                    </Grid>

                    <!-- Modified Settings Banner -->
                    <Border Visibility="{Binding IsProfileModified, Converter={StaticResource BoolToVis}}"
                            Background="#1AFAA307" BorderBrush="#4DFAA307" BorderThickness="1" CornerRadius="10" 
                            Padding="14,9" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="13" />
                                <TextBlock Text="{Binding ProfileModifiedWarning}" FontSize="11.5" FontWeight="SemiBold" 
                                           Foreground="#FAA307" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="26" Padding="12,0" 
                                        Content="Revert to Profile" Command="{Binding ReapplyActiveProfileCommand}" Margin="0,0,8,0" FontSize="10.5" />
                                <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="26" Padding="12,0" 
                                        Content="Save as New Profile" Command="{Binding SaveCurrentAsCustomProfileCommand}" FontSize="10.5" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Two-Column Layout: Left Profiles Grid, Right Profile Inspector -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Profile Cards List -->
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" CornerRadius="12" Padding="14,12"
                                            Background="{StaticResource PrismCardGlassBrush}"
                                            BorderBrush="{StaticResource PrismBorderSubtleBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Profile Info & Metrics -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" 
                                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                    <Border Background="#15FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" 
                                                            CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                                                <!-- Hardware Key Metrics -->
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#1076C7C0" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Brightness, StringFormat='{}Br: {0}%'}" FontSize="10" 
                                                                   FontWeight="SemiBold" Foreground="{StaticResource DisplayAccentBrush}" />
                                                    </Border>
                                                    <Border Background="#10A995E8" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Contrast, StringFormat='{}Ct: {0}%'}" FontSize="10" 
                                                                   FontWeight="SemiBold" Foreground="{StaticResource AudioAccentBrush}" />
                                                    </Border>
                                                    <Border Background="#10FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding ColorTemperature}" FontSize="10" 
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Card Actions -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <!-- Select / Inspect Button -->
                                                <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="28" Padding="10,0" 
                                                        Content="Inspect" Margin="0,0,6,0" FontSize="11"
                                                        Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />

                                                <!-- Apply Button -->
                                                <Button Style="{StaticResource PrismPrimaryButtonStyle}" Height="28" Padding="12,0" 
                                                        Content="Apply" Margin="0,0,6,0" FontSize="11"
                                                        Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />

                                                <!-- Duplicate -->
                                                <Button Style="{StaticResource PrismIconButtonStyle}" Width="26" Height="26" Content="⎘" 
                                                        ToolTip="Duplicate Profile" FontSize="12" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.DuplicateProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />

                                                <!-- Delete (Custom only) -->
                                                <Button Style="{StaticResource PrismIconButtonStyle}" Width="26" Height="26" Content="✕" 
                                                        ToolTip="Delete Profile" FontSize="10" Foreground="#EF4444"
                                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding IsCustom}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Right Column: Detail & Configuration Inspector Panel -->
                        <Border Grid.Column="2" Background="{StaticResource PrismElevatedGlassBrush}" 
                                BorderBrush="{StaticResource PrismBorderSubtleBrush}" BorderThickness="1" 
                                CornerRadius="14" Padding="16">
                            <StackPanel>
                                <TextBlock Text="PROFILE INSPECTOR &amp; CAPABILITIES" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue='No Profile Selected'}" 
                                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Border HorizontalAlignment="Right" Background="#15FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" 
                                            CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="{Binding SelectedProfile.Category, FallbackValue='Factory'}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding SelectedProfile.Description, FallbackValue='Select a profile to inspect capabilities'}" 
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                                <Separator Background="{StaticResource PrismBorderSubtleBrush}" Margin="0,0,0,12" />

                                <!-- Capabilities Breakdown -->
                                <StackPanel Margin="0,0,0,14">
                                    <!-- Brightness -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Brightness (VCP 0x10)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SelectedProfile.Brightness, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DisplayAccentBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="• HW Supported" FontSize="9.5" Foreground="#10B981" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Contrast -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Contrast (VCP 0x12)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SelectedProfile.Contrast, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AudioAccentBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="• HW Supported" FontSize="9.5" Foreground="#10B981" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- RGB Gains -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="RGB Video Gains" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SelectedProfile.RedGain}" FontSize="11" FontWeight="Bold" Foreground="#EF4444" />
                                            <TextBlock Text="/" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="2,0" />
                                            <TextBlock Text="{Binding SelectedProfile.GreenGain}" FontSize="11" FontWeight="Bold" Foreground="#63C99A" />
                                            <TextBlock Text="/" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="2,0" />
                                            <TextBlock Text="{Binding SelectedProfile.BlueGain}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DisplayAccentBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="• HW Supported" FontSize="9.5" Foreground="#10B981" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Color Temperature -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Color Temperature" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedProfile.ColorTemperature}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Sharpness (Honest reporting) -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Sharpness" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="Native / Scaler Default" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Saturation (Honest reporting) -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Color Saturation" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="Unsupported by Monitor" FontSize="10" Foreground="#F59E0B" HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Gamma (Honest reporting) -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Gamma Curve" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="2.2 (System SDR Transfer)" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Software Dimming -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Sub-Zero Dimming" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedProfile.SoftwareDimmingLevel, StringFormat='{}{0}% (Window Layer)'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <Separator Background="{StaticResource PrismBorderSubtleBrush}" Margin="0,0,0,14" />

                                <!-- Inspector Actions -->
                                <Button Style="{StaticResource PrismPrimaryButtonStyle}" Height="34" Margin="0,0,0,8" 
                                        Content="Apply Profile to Display"
                                        Command="{Binding ApplySelectedProfileCommand}" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource PrismSecondaryButtonStyle}" Height="30" FontSize="11"
                                            Content="Preview" Command="{Binding PreviewProfileCommand}" />
                                    <Button Grid.Column="2" Style="{StaticResource PrismSecondaryButtonStyle}" Height="30" FontSize="11"
                                            Content="Export File" Command="{Binding ExportProfileCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- ROW 6: HARDWARE DIAGNOSTICS & TELEMETRY DRAWER            -->
            <!-- ========================================================= -->
            <Border Grid.Row="6" Style="{StaticResource PrismCardStyle}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource InfoIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="HARDWARE DIAGNOSTICS &amp; TELEMETRY" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="26" Padding="10,0" 
                                Content="Toggle Diagnostics" Command="{Binding ToggleDiagnosticsCommand}" 
                                HorizontalAlignment="Right" FontSize="10" />
                    </Grid>

                    <Border Visibility="{Binding IsDiagnosticsExpanded, Converter={StaticResource BoolToVis}}" 
                            Background="#0B0F19" BorderBrush="{StaticResource PrismBorderSubtleBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                        <TextBox Text="{Binding DiagnosticsDump, Mode=OneWay}" 
                                 FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" 
                                 Foreground="#38BDF8" Background="Transparent" BorderThickness="0" 
                                 IsReadOnly="True" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
