<UserControl x:Class="PRISM.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1020">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="OnPreviewMouseWheel">
        <Grid Margin="32,24,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0: Header -->
                <RowDefinition Height="Auto" /> <!-- 1: Dual Device Cards -->
                <RowDefinition Height="Auto" /> <!-- 2: Dual Master Sliders -->
                <RowDefinition Height="Auto" /> <!-- 3: Environments -->
                <RowDefinition Height="Auto" /> <!-- 4: Dual Studio Quick Access Sections -->
            </Grid.RowDefinitions>

            <!-- ========================================================= -->
            <!-- ROW 0: TOP HEADLINE                                       -->
            <!-- ========================================================= -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Display &amp; Audio, in Sync." 
                           FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" 
                           LineHeight="32" Margin="0,0,0,4" />
                <TextBlock Text="A unified studio to control your screen, sound and workspace experience." 
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- ========================================================= -->
            <!-- ROW 1: DUAL DEVICE STATUS CARDS (SIDE-BY-SIDE)            -->
            <!-- ========================================================= -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Monitor Hero Card (Acer ED270 X0) -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceSecondaryBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                        CornerRadius="16" Padding="16,14" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenDisplayStudioCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Monitor Visual Thumbnail -->
                        <Border Grid.Column="0" Width="68" Height="52" CornerRadius="8" Margin="0,0,16,0" 
                                Background="#101722" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <!-- Screen Bezel and Desktop Art -->
                                <Border CornerRadius="6" Margin="3,3,3,10" Background="#0A111E">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,60,38" RadiusX="4" RadiusY="4" />
                                    </Border.Clip>
                                    <Image Source="pack://application:,,,/PRISM;component/Assets/Environments/late_night.jpg" 
                                           Stretch="UniformToFill" Opacity="0.8" />
                                </Border>
                                <!-- Stand -->
                                <Rectangle Width="14" Height="7" Fill="#343E4C" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,3" RadiusX="1" RadiusY="1" />
                                <Rectangle Width="26" Height="2" Fill="#4B5563" VerticalAlignment="Bottom" HorizontalAlignment="Center" RadiusX="1" RadiusY="1" />
                            </Grid>
                        </Border>

                        <!-- Monitor Identity Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MonitorName}" FontSize="15" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="Acer Monitor" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding MonitorResolutionRate}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            
                            <!-- Connected Chip Badge -->
                            <Border Style="{StaticResource PrismStatusChipStyle}" 
                                    Background="#1A63C99A" BorderBrush="#3363C99A" HorizontalAlignment="Left" Padding="8,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding MonitorConnectionStatus}" FontSize="10.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Chevron Action -->
                        <Button Grid.Column="2" Style="{StaticResource PrismIconButtonStyle}" Width="32" Height="32" 
                                Command="{Binding OpenDisplayStudioCommand}" ToolTip="Open Display Studio">
                            <Path Data="{StaticResource ChevronRightIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                  Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Audio Hero Card (Cosmic Byte Proteus) -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceSecondaryBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                        CornerRadius="16" Padding="16,14" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenAudioStudioCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Headphone Visual Thumbnail -->
                        <Border Grid.Column="0" Width="68" Height="52" CornerRadius="8" Margin="0,0,16,0" 
                                Background="#101722" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Glowing Purple Ambient Ring Behind Headphone -->
                                <Ellipse Width="34" Height="34" Fill="#33A99AC8">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="8" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Path Data="{StaticResource HeadphonesIconGeometry}" Fill="{StaticResource AudioAccentBrush}" 
                                      Width="24" Height="24" Stretch="Uniform" />
                            </Grid>
                        </Border>

                        <!-- Audio Device Identity Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AudioDeviceName}" FontSize="15" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding AudioDeviceType}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding AudioDeviceSpecs}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />

                            <!-- Active Chip Badge -->
                            <Border Style="{StaticResource PrismStatusChipStyle}" 
                                    Background="#1AA99AC8" BorderBrush="#33A99AC8" HorizontalAlignment="Left" Padding="8,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AudioAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AudioEndpointStatus}" FontSize="10.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource AudioAccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Chevron Action -->
                        <Button Grid.Column="2" Style="{StaticResource PrismIconButtonStyle}" Width="32" Height="32" 
                                Command="{Binding OpenAudioStudioCommand}" ToolTip="Open Audio Studio">
                            <Path Data="{StaticResource ChevronRightIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                  Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================= -->
            <!-- ROW 2: DUAL MASTER SLIDERS (SIDE-BY-SIDE)                 -->
            <!-- ========================================================= -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Brightness Master Slider -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceSecondaryBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                        CornerRadius="14" Padding="16,12">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Data="{StaticResource SunIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                              Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Brightness" FontSize="12.5" FontWeight="Medium" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <Slider Grid.Column="2" Style="{StaticResource PrismSliderStyle}" 
                                Minimum="0" Maximum="100" Value="{Binding Brightness, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Brightness, StringFormat='{}{0}%'}" 
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" 
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <!-- Right: Master Volume Slider + Mute Button -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceSecondaryBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                        CornerRadius="14" Padding="16,12">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Data="{StaticResource SpeakerIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                              Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Volume" FontSize="12.5" FontWeight="Medium" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <Slider Grid.Column="2" Style="{StaticResource PrismAudioSliderStyle}" 
                                Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Volume, StringFormat='{}{0}%'}" 
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" 
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,12,0" />

                        <!-- Mute Toggle Button -->
                        <Button Grid.Column="4" Style="{StaticResource PrismIconButtonStyle}" Width="32" Height="32" 
                                Command="{Binding ToggleMuteCommand}" ToolTip="Toggle Audio Mute">
                            <Path Data="{StaticResource SpeakerMuteIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================= -->
            <!-- ROW 3: ENVIRONMENTS SECTION                               -->
            <!-- ========================================================= -->
            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <!-- Section Header -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource EnvironmentIconGeometry}" Fill="{StaticResource AudioAccentBrush}" 
                              Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Environments" FontSize="15" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="One-tap profiles that optimize display and audio for your activity." 
                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource PrismSecondaryButtonStyle}" Height="30" Padding="12,0" 
                            Command="{Binding OpenEnvironmentsCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Manage Environments" FontSize="11.5" FontWeight="Medium" 
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource ChevronRightIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                  Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 4 Atmosphere Photo Cards -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 1. Daylight Focus -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceSecondaryBrush}" 
                            CornerRadius="14" Height="136" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDaylightFocusActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource DisplayAccentBrush}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#76C7C0" BlurRadius="12" ShadowDepth="0" Opacity="0.35" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectEnvironmentCommand}" CommandParameter="Daylight Focus" />
                        </Border.InputBindings>
                        <Grid>
                            <Border CornerRadius="14">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,240,136" RadiusX="14" RadiusY="14" />
                                </Border.Clip>
                                <Grid>
                                    <Image Source="pack://application:,,,/PRISM;component/Assets/Environments/daylight_focus.jpg" 
                                           Stretch="UniformToFill" Opacity="0.5" />
                                    <Border Background="#A60D1117" />
                                </Grid>
                            </Border>

                            <!-- Checkmark Badge on Top Right -->
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource DisplayAccentBrush}" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                    Visibility="{Binding IsDaylightFocusActive, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource CheckIconGeometry}" Fill="#0D1117" Width="10" Height="10" 
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel VerticalAlignment="Bottom" Margin="14">
                                <Path Data="{StaticResource SunIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,10" />
                                <TextBlock Text="Daylight Focus" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                <TextBlock Text="Bright, clear and productive." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. Late Night -->
                    <Border Grid.Column="2" Background="{StaticResource SurfaceSecondaryBrush}" 
                            CornerRadius="14" Height="136" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLateNightActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AudioAccentBrush}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#A99AC8" BlurRadius="12" ShadowDepth="0" Opacity="0.35" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectEnvironmentCommand}" CommandParameter="Late Night" />
                        </Border.InputBindings>
                        <Grid>
                            <Border CornerRadius="14">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,240,136" RadiusX="14" RadiusY="14" />
                                </Border.Clip>
                                <Grid>
                                    <Image Source="pack://application:,,,/PRISM;component/Assets/Environments/late_night.jpg" 
                                           Stretch="UniformToFill" Opacity="0.55" />
                                    <Border Background="#A60D1117" />
                                </Grid>
                            </Border>

                            <!-- Checkmark Badge on Top Right -->
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource AudioAccentBrush}" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                    Visibility="{Binding IsLateNightActive, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource CheckIconGeometry}" Fill="#0D1117" Width="10" Height="10" 
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel VerticalAlignment="Bottom" Margin="14">
                                <Path Data="{StaticResource MoonIconGeometry}" Fill="{StaticResource AudioAccentBrush}" 
                                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,10" />
                                <TextBlock Text="Late Night" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                <TextBlock Text="Comfortable low-light experience." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Competitive Gaming -->
                    <Border Grid.Column="4" Background="{StaticResource SurfaceSecondaryBrush}" 
                            CornerRadius="14" Height="136" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompetitiveGamingActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource DisplayAccentBrush}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#76C7C0" BlurRadius="12" ShadowDepth="0" Opacity="0.35" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectEnvironmentCommand}" CommandParameter="Competitive Gaming" />
                        </Border.InputBindings>
                        <Grid>
                            <Border CornerRadius="14">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,240,136" RadiusX="14" RadiusY="14" />
                                </Border.Clip>
                                <Grid>
                                    <Image Source="pack://application:,,,/PRISM;component/Assets/Environments/competitive_gaming.jpg" 
                                           Stretch="UniformToFill" Opacity="0.5" />
                                    <Border Background="#A60D1117" />
                                </Grid>
                            </Border>

                            <!-- Checkmark Badge on Top Right -->
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource DisplayAccentBrush}" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                    Visibility="{Binding IsCompetitiveGamingActive, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource CheckIconGeometry}" Fill="#0D1117" Width="10" Height="10" 
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel VerticalAlignment="Bottom" Margin="14">
                                <Path Data="{StaticResource GamepadIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,10" />
                                <TextBlock Text="Competitive Gaming" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                <TextBlock Text="Low latency and detailed audio." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 4. Cinematic Movie -->
                    <Border Grid.Column="6" Background="{StaticResource SurfaceSecondaryBrush}" 
                            CornerRadius="14" Height="136" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCinematicMovieActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AudioAccentBrush}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#A99AC8" BlurRadius="12" ShadowDepth="0" Opacity="0.35" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectEnvironmentCommand}" CommandParameter="Cinematic Movie" />
                        </Border.InputBindings>
                        <Grid>
                            <Border CornerRadius="14">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,240,136" RadiusX="14" RadiusY="14" />
                                </Border.Clip>
                                <Grid>
                                    <Image Source="pack://application:,,,/PRISM;component/Assets/Environments/cinematic_movie.jpg" 
                                           Stretch="UniformToFill" Opacity="0.5" />
                                    <Border Background="#A60D1117" />
                                </Grid>
                            </Border>

                            <!-- Checkmark Badge on Top Right -->
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource AudioAccentBrush}" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                    Visibility="{Binding IsCinematicMovieActive, Converter={StaticResource BoolToVis}}">
                                <Path Data="{StaticResource CheckIconGeometry}" Fill="#0D1117" Width="10" Height="10" 
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel VerticalAlignment="Bottom" Margin="14">
                                <Path Data="{StaticResource FilmIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,10" />
                                <TextBlock Text="Cinematic Movie" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                <TextBlock Text="Immersive cinema experience." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ========================================================= -->
            <!-- ROW 4: DUAL STUDIO QUICK ACCESS MODULES (SIDE-BY-SIDE)    -->
            <!-- ========================================================= -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Display Studio Quick Access -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceSecondaryBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                        CornerRadius="16" Padding="18,16">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="{StaticResource DisplayIconGeometry}" Fill="{StaticResource DisplayAccentBrush}" 
                                  Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Display Studio" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Tune your display for clarity, comfort and color accuracy." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource PrismIconButtonStyle}" Width="28" Height="28" 
                                    Command="{Binding OpenDisplayStudioCommand}" ToolTip="Open Display Studio">
                                <Path Data="{StaticResource ChevronRightIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                      Width="11" Height="11" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <!-- Brightness Slider Row -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource SunIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Brightness" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <Slider Grid.Column="2" Style="{StaticResource PrismSliderStyle}" Minimum="0" Maximum="100" 
                                    Value="{Binding Brightness, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Brightness, StringFormat='{}{0}%'}" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Contrast Slider Row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource ContrastIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Contrast" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <Slider Grid.Column="2" Style="{StaticResource PrismSliderStyle}" Minimum="0" Maximum="100" 
                                    Value="{Binding Contrast, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Contrast, StringFormat='{}{0}%'}" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- RGB Gains Section -->
                        <Border Background="#161B22" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="RGB Gains" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                                <!-- Red (R) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Red (R)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding RedGain}" Minimum="0" Maximum="100" Height="6" 
                                                 Foreground="#EF4444" Background="#263442" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding RedGain, StringFormat='{}{0}%'}" FontSize="11" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Green (G) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Green (G)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding GreenGain}" Minimum="0" Maximum="100" Height="6" 
                                                 Foreground="#63C99A" Background="#263442" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding GreenGain, StringFormat='{}{0}%'}" FontSize="11" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Blue (B) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Blue (B)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding BlueGain}" Minimum="0" Maximum="100" Height="6" 
                                                 Foreground="{StaticResource DisplayAccentBrush}" Background="#263442" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding BlueGain, StringFormat='{}{0}%'}" FontSize="11" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right: Audio Studio Quick Access -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceSecondaryBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" 
                        CornerRadius="16" Padding="18,16">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="{StaticResource AudioIconGeometry}" Fill="{StaticResource AudioAccentBrush}" 
                                  Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Audio Studio" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Shape your sound with EQ, presets and audio enhancements." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource PrismIconButtonStyle}" Width="28" Height="28" 
                                    Command="{Binding OpenAudioStudioCommand}" ToolTip="Open Audio Studio">
                                <Path Data="{StaticResource ChevronRightIconGeometry}" Fill="{StaticResource TextSecondaryBrush}" 
                                      Width="11" Height="11" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <!-- Category Filter Pills -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="24" Padding="10,0" Margin="0,0,6,0" 
                                    Content="Music" FontSize="10.5" Command="{Binding FilterAudioCategoryCommand}" CommandParameter="Music" />
                            <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="24" Padding="10,0" Margin="0,0,6,0" 
                                    Content="Gaming" FontSize="10.5" Command="{Binding FilterAudioCategoryCommand}" CommandParameter="Gaming" />
                            <!-- Active Category Pill (Movies) -->
                            <Border Background="{StaticResource AudioAccentBrush}" CornerRadius="12" Padding="10,3" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="Movies" FontSize="10.5" FontWeight="Bold" Foreground="#0D1117" VerticalAlignment="Center" />
                            </Border>
                            <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="24" Padding="10,0" Margin="0,0,6,0" 
                                    Content="Voice" FontSize="10.5" Command="{Binding FilterAudioCategoryCommand}" CommandParameter="Voice" />
                            <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="24" Padding="10,0" 
                                    Content="Custom" FontSize="10.5" Command="{Binding FilterAudioCategoryCommand}" CommandParameter="Custom" />
                        </StackPanel>

                        <!-- Audio Visualization & Selected Preset Card Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: 10-Band Animated EQ Visualizer Bars with dB Scale -->
                            <Border Grid.Column="0" Background="#161B22" BorderBrush="{StaticResource BorderSubtleBrush}" 
                                    BorderThickness="1" CornerRadius="10" Padding="8,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 10 Vertical Bars -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="82">
                                        <Border Width="7" Height="38" Background="{StaticResource AudioAccentBrush}" CornerRadius="3.5" Margin="2,0" VerticalAlignment="Bottom" />
                                        <Border Width="7" Height="48" Background="{StaticResource AudioAccentBrush}" CornerRadius="3.5" Margin="2,0" VerticalAlignment="Bottom" />
                                        <Border Width="7" Height="62" Background="{StaticResource AudioAccentBrush}" CornerRadius="3.5" Margin="2,0" VerticalAlignment="Bottom" />
                                        <Border Width="7" Height="54" Background="{StaticResource AudioAccentBrush}" CornerRadius="3.5" Margin="2,0" VerticalAlignment="Bottom" />
                                        <Border Width="7" Height="42" Background="{StaticResource AudioAccentBrush}" CornerRadius="3.5" Margin="2,0" VerticalAlignment="Bottom" />
                                        <Border Width="7" Height="50" Background="{StaticResource AudioAccentBrush}" CornerRadius="3.5" Margin="2,0" VerticalAlignment="Bottom" />
                                        <Border Width="7" Height="58" Background="{StaticResource AudioAccentBrush}" CornerRadius="3.5" Margin="2,0" VerticalAlignment="Bottom" />
                                        <Border Width="7" Height="68" Background="{StaticResource AudioAccentBrush}" CornerRadius="3.5" Margin="2,0" VerticalAlignment="Bottom" />
                                        <Border Width="7" Height="56" Background="{StaticResource AudioAccentBrush}" CornerRadius="3.5" Margin="2,0" VerticalAlignment="Bottom" />
                                        <Border Width="7" Height="44" Background="{StaticResource AudioAccentBrush}" CornerRadius="3.5" Margin="2,0" VerticalAlignment="Bottom" />
                                    </StackPanel>

                                    <!-- Frequency Axis Labels -->
                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                        <TextBlock Text="31" FontSize="7" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                        <TextBlock Text="1K" FontSize="7" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="16K" FontSize="7" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Right: Active Preset Card Deck -->
                            <Border Grid.Column="2" Background="#161B22" BorderBrush="{StaticResource BorderSubtleBrush}" 
                                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Preset Name with Clapper Icon -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                        <Path Data="{StaticResource FilmIconGeometry}" Fill="{StaticResource AudioAccentBrush}" 
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ActiveAudioPresetName}" FontSize="12.5" FontWeight="Bold" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="{Binding ActiveAudioPresetDescription}" FontSize="10" 
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="13" Margin="0,0,0,8" />

                                    <!-- Dynamic Mini EQ Response Curve -->
                                    <Border Grid.Row="2" Height="30" Background="#10141D" CornerRadius="6" Padding="6,2" Margin="0,0,0,10">
                                        <Path Data="{Binding ActiveAudioPresetCurvePath}" Stroke="{StaticResource AudioAccentBrush}" 
                                              StrokeThickness="1.8" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    </Border>

                                    <!-- Action Buttons Deck -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                                        <Button Style="{StaticResource PrismPrimaryButtonStyle}" Height="26" Padding="12,0" Margin="0,0,6,0" 
                                                Background="{StaticResource AudioAccentBrush}" BorderThickness="0"
                                                Command="{Binding ApplyQuickAudioProfileCommand}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource CheckIconGeometry}" Fill="#0D1117" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Apply" FontSize="10.5" FontWeight="Bold" Foreground="#0D1117" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="26" Padding="10,0" Margin="0,0,6,0" 
                                                Command="{Binding ToggleAudioABCommand}" ToolTip="A/B Toggle">
                                            <TextBlock Text="▷ A / B" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="26" Padding="8,0" 
                                                Command="{Binding ResetQuickAudioCommand}" ToolTip="Reset to Flat">
                                            <TextBlock Text="↺ Reset" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>