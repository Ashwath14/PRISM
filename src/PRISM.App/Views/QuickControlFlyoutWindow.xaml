<Window x:Class="PRISM.App.Views.QuickControlFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PRISM Quick Controls" 
        Height="540" Width="384"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <!-- Main Acrylic Liquid Glass Floating Shell -->
    <Border x:Name="MainCard" Background="#F00D1322" 
            BorderBrush="{StaticResource GlassButtonBorderBrush}" BorderThickness="1.2" 
            CornerRadius="20" Margin="10" RenderTransformOrigin="0.5,1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="FlyoutTranslate" Y="0" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="10" Opacity="0.75" />
        </Border.Effect>

        <Grid Margin="18,16,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Display Section -->
                <RowDefinition Height="Auto" /> <!-- Audio Section -->
                <RowDefinition Height="Auto" /> <!-- Environments Section -->
                <RowDefinition Height="*" />    <!-- Footer Links -->
            </Grid.RowDefinitions>

            <!-- 1. Header with Squircle 'P' Logo, Active Pill & Window Actions -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource CyanAccentGradient}" Margin="0,0,10,0">
                        <Path Data="{StaticResource PrismLogoGeometry}" Fill="#080C14" Width="13" Height="13" 
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PRISM" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Active Environment Badge -->
                <Border Grid.Column="1" HorizontalAlignment="Center" CornerRadius="12"
                        Background="#2600C7FF" BorderBrush="#6600C7FF" BorderThickness="1" 
                        Padding="10,3" VerticalAlignment="Center" ToolTip="Currently Active Unified Environment">
                    <TextBlock Text="{Binding ActiveEnvironmentName}" FontSize="10.5" FontWeight="SemiBold" 
                               Foreground="{StaticResource ElectricCyanBrush}" VerticalAlignment="Center" />
                </Border>

                <!-- Mode & Close Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrismIconButtonStyle}" Width="28" Height="28" 
                            Command="{Binding ToggleCompactModeCommand}" Margin="0,0,6,0" 
                            ToolTip="Toggle Compact / Expanded Mode (Hotkey: C)">
                        <TextBlock Text="↕" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource PrismIconButtonStyle}" Width="28" Height="28" 
                            Command="{Binding CloseFlyoutCommand}" ToolTip="Close (Esc)">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Display Hardware Section -->
            <Border Grid.Row="1" Background="#CC121927" BorderBrush="{StaticResource PrismGlassCardBorderBrush}" 
                    BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource DisplayIconGeometry}" Fill="{StaticResource ElectricCyanBrush}" 
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveMonitorName}" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Brightness, StringFormat='{}{0}%'}" FontSize="13" FontWeight="Bold" 
                                   Foreground="{StaticResource ElectricCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Liquid Glass Display Slider -->
                    <Slider Style="{StaticResource PrismSliderStyle}" Minimum="0" Maximum="100" 
                            Value="{Binding Brightness, Mode=TwoWay}" Margin="0,0,0,6" 
                            ToolTip="Physical Monitor Luminance (DDC/CI VCP 0x10)" />

                    <!-- Sub-Zero Toggle (Expanded Mode Only) -->
                    <Grid x:Name="SubZeroRow" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource PrismToggleSwitchStyle}" IsChecked="{Binding IsSubZeroDimEnabled, Mode=TwoWay}" VerticalAlignment="Center" 
                                      ToolTip="Compositor Dimming Layer below hardware minimum" />
                            <TextBlock Text="Sub-Zero Dimming" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding SubZeroDimPercent, StringFormat='{}{0}%'}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="{Binding IsSubZeroDimEnabled, Converter={StaticResource BoolToVisConverter}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Audio Subsystem Section -->
            <Border Grid.Row="2" Background="#CC121927" BorderBrush="{StaticResource PrismGlassCardBorderBrush}" 
                    BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Button Style="{StaticResource PrismSecondaryButtonStyle}" Height="26" Padding="10,0" 
                                Command="{Binding SwitchOutputDeviceCommand}" HorizontalAlignment="Left"
                                ToolTip="Click to switch default audio playback device">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource HeadphonesIconGeometry}" Fill="{StaticResource AudioAccentBrush}" 
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveDeviceName}" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrismIconButtonStyle}" Width="26" Height="26" 
                                    Command="{Binding ToggleMuteCommand}" Margin="0,0,8,0" ToolTip="Mute / Unmute (Hotkey: M)">
                                <Path Data="{StaticResource AudioIconGeometry}" Fill="{StaticResource AudioAccentBrush}" 
                                      Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <TextBlock Text="{Binding MasterVolume, StringFormat='{}{0}%'}" FontSize="13" FontWeight="Bold" 
                                       Foreground="{StaticResource AudioAccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Liquid Glass Audio Slider -->
                    <Slider Style="{StaticResource PrismAudioSliderStyle}" Minimum="0" Maximum="100" 
                            Value="{Binding MasterVolume, Mode=TwoWay}" ToolTip="WASAPI Master Playback Volume" />
                </StackPanel>
            </Border>

            <!-- 4. Visual Environments Thumbnail Deck -->
            <Border Grid.Row="3" Background="#CC121927" BorderBrush="{StaticResource PrismGlassCardBorderBrush}" 
                    BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="2,0,2,8">
                        <TextBlock Text="ONE-TOUCH ENVIRONMENTS" FontSize="10.5" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Keys 1–4" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" Rows="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Visual Atmosphere Tile -->
                                <Border Height="52" Margin="3" CornerRadius="10" Cursor="Hand" ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="1.2" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrismGlassCardBorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource ElectricCyanBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                      Command="{Binding DataContext.ApplyEnvironmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <!-- Background Image Asset -->
                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill" />
                                        
                                        <!-- Dark Gradient Readability Scrim -->
                                        <Border CornerRadius="9">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#4D000000" Offset="0.0" />
                                                    <GradientStop Color="#D9080C14" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Title & Active Dot -->
                                        <Grid Margin="8,0,8,6" VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <!-- Green Active LED -->
                                            <Ellipse Grid.Column="1" Width="6" Height="6" Fill="{StaticResource SuccessGreenBrush}" 
                                                     VerticalAlignment="Center" Margin="4,0,0,0"
                                                     Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#10B981" BlurRadius="4" ShadowDepth="0" Opacity="0.9" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 5. Footer Studio Quick Navigation Links (Expanded Mode Only) -->
            <Grid x:Name="FooterLinksRow" Grid.Row="4" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource PrismSecondaryButtonStyle}" Height="34" 
                        Command="{Binding OpenDisplayStudioCommand}" ToolTip="Launch Full Display Studio">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource DisplayIconGeometry}" Fill="{StaticResource ElectricCyanBrush}" 
                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Display Studio" FontSize="11.5" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource PrismSecondaryButtonStyle}" Height="34" 
                        Command="{Binding OpenAudioStudioCommand}" ToolTip="Launch Full Audio Studio">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource AudioIconGeometry}" Fill="{StaticResource AudioAccentBrush}" 
                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Audio Studio" FontSize="11.5" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
