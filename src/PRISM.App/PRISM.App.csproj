<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PRISM.Core\PRISM.Core.csproj" />
    <ProjectReference Include="..\PRISM.Hardware\PRISM.Hardware.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PRISM.ico" />
    <Resource Include="Assets\Environments\*.jpg" />
    <None Update="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\PRISM.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <StartupObject>PRISM.App.Program</StartupObject>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <!-- Assembly Metadata -->
    <AssemblyName>PRISM</AssemblyName>
    <AssemblyTitle>PRISM Display &amp; Audio Studio</AssemblyTitle>
    <Product>PRISM</Product>
    <Company>PRISM Software</Company>
    <Description>Premium Windows Display &amp; Audio Control Studio</Description>
    <Copyright>Copyright © 2026 PRISM</Copyright>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0-phase2</InformationalVersion>
  </PropertyGroup>

</Project>
