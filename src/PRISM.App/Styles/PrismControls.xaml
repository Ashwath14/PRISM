<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PrismColors.xaml" />
        <ResourceDictionary Source="PrismIcons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================= -->
    <!-- ACCESSIBILITY FOCUS VISUAL STYLE                                  -->
    <!-- ================================================================= -->
    <Style x:Key="PrismFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource ElectricCyanBrush}" 
                            BorderThickness="1.5" 
                            CornerRadius="8" 
                            Margin="-2" 
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!-- GLASS SURFACES & CARDS                                            -->
    <!-- ================================================================= -->

    <!-- Primary Content Card (Level 1 Elevation - Refined Smoked Translucent Surface) -->
    <Style x:Key="PrismCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrismGlassCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrismGlassCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="4" Opacity="0.45" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Elevated / Modal Glass Card (Level 2 Elevation - Floating Smoked Surface) -->
    <Style x:Key="PrismElevatedCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrismElevatedGlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrismGlassCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.55" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!-- NAVIGATION SIDEBAR BUTTON                                         -->
    <!-- ================================================================= -->
    <Style x:Key="PrismNavButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PrismFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,0" SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Active Left Indicator Pill -->
                            <Rectangle x:Name="ActivePill" Width="3" Height="22" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource ElectricCyanBrush}" Visibility="Collapsed" />

                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrismHoverSheenBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrismCardGlassBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrismBorderSubtleBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                            <Setter TargetName="ActivePill" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!-- PRISM TACTILE CAPSULE SLIDERS                                     -->
    <!-- ================================================================= -->

    <!-- ================================================================= -->
    <!-- REFERENCE 1: PRISM LIQUID GLASS SLIDERS (BRIGHTNESS & VOLUME)      -->
    <!-- ================================================================= -->

    <!-- Liquid Glass Capsule Slider Thumb (Display Domain) -->
    <Style x:Key="PrismCapsuleThumbStyle" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="48" Height="26">
                        <!-- Diffuse Ambient Cyan Glow (Reference 1: Liquid Glass) -->
                        <Border x:Name="ThumbGlow" Width="42" Height="22" CornerRadius="11" Background="{StaticResource DisplayAccentBrush}" Opacity="0">
                            <Border.Effect>
                                <BlurEffect Radius="8" />
                            </Border.Effect>
                        </Border>
                        <!-- Liquid Glass Pill Cap with Refractive Bevel -->
                        <Border x:Name="ThumbPill" Width="40" Height="22" CornerRadius="11" 
                                Background="{StaticResource LiquidGlassThumbBrush}"
                                BorderBrush="{StaticResource LiquidGlassThumbRimBrush}" BorderThickness="1.2">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.45" />
                            </Border.Effect>
                            <!-- Center Optical Grip Lines -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="1.5" Height="10" RadiusX="0.75" RadiusY="0.75" Fill="#64748B" Margin="0,0,3,0" Opacity="0.7" />
                                <Rectangle Width="1.5" Height="10" RadiusX="0.75" RadiusY="0.75" Fill="#64748B" Opacity="0.7" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbPill" Property="Width" Value="44" />
                            <Setter TargetName="ThumbPill" Property="BorderBrush" Value="{StaticResource DisplayAccentBrush}" />
                            <Setter TargetName="ThumbGlow" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Cursor" Value="SizeWE" />
                            <Setter TargetName="ThumbPill" Property="Width" Value="46" />
                            <Setter TargetName="ThumbPill" Property="Height" Value="20" />
                            <Setter TargetName="ThumbPill" Property="Background" Value="{StaticResource LiquidGlassThumbBrush}" />
                            <Setter TargetName="ThumbPill" Property="BorderBrush" Value="{StaticResource DisplayAccentBrush}" />
                            <Setter TargetName="ThumbGlow" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liquid Glass Capsule Slider Thumb (Audio Domain) -->
    <Style x:Key="PrismAudioCapsuleThumbStyle" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="48" Height="26">
                        <!-- Diffuse Ambient Purple Glow -->
                        <Border x:Name="ThumbGlow" Width="42" Height="22" CornerRadius="11" Background="{StaticResource AudioAccentBrush}" Opacity="0">
                            <Border.Effect>
                                <BlurEffect Radius="8" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ThumbPill" Width="40" Height="22" CornerRadius="11" 
                                Background="{StaticResource LiquidGlassThumbBrush}"
                                BorderBrush="{StaticResource LiquidGlassAudioThumbRimBrush}" BorderThickness="1.2">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.45" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="1.5" Height="10" RadiusX="0.75" RadiusY="0.75" Fill="{StaticResource AudioAccentBrush}" Margin="0,0,3,0" Opacity="0.7" />
                                <Rectangle Width="1.5" Height="10" RadiusX="0.75" RadiusY="0.75" Fill="{StaticResource AudioAccentBrush}" Opacity="0.7" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbPill" Property="Width" Value="44" />
                            <Setter TargetName="ThumbPill" Property="BorderBrush" Value="{StaticResource AudioAccentBrush}" />
                            <Setter TargetName="ThumbGlow" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Cursor" Value="SizeWE" />
                            <Setter TargetName="ThumbPill" Property="Width" Value="46" />
                            <Setter TargetName="ThumbPill" Property="Height" Value="20" />
                            <Setter TargetName="ThumbPill" Property="Background" Value="{StaticResource LiquidGlassThumbBrush}" />
                            <Setter TargetName="ThumbPill" Property="BorderBrush" Value="{StaticResource AudioAccentBrush}" />
                            <Setter TargetName="ThumbGlow" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Display Capsule Slider (Height 28px, Long Slim Track) -->
    <Style x:Key="PrismSliderStyle" TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PrismFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- Inactive Track Trough (Full Pill) -->
                        <Border x:Name="TrackBackground" Height="10" CornerRadius="5" 
                                Background="{StaticResource LiquidGlassTrackBrush}"
                                BorderBrush="{StaticResource LiquidGlassTrackBorderBrush}" BorderThickness="1" />

                        <!-- Active Filled Track & Liquid Glass Thumb -->
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="10" CornerRadius="5,0,0,5" Background="{StaticResource SliderTrackGradient}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PrismCapsuleThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Audio Capsule Slider (Height 28px) -->
    <Style x:Key="PrismAudioSliderStyle" TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PrismFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border x:Name="TrackBackground" Height="10" CornerRadius="5" 
                                Background="{StaticResource LiquidGlassTrackBrush}"
                                BorderBrush="{StaticResource LiquidGlassTrackBorderBrush}" BorderThickness="1" />

                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="10" CornerRadius="5,0,0,5" Background="{StaticResource AudioSliderTrackGradient}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PrismAudioCapsuleThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!-- REFERENCE 2: PRISM SPECTRAL EQUALIZER VERTICAL FADERS             -->
    <!-- ================================================================= -->

    <!-- Machined Mixer Fader Cap Thumb -->
    <Style x:Key="PrismVerticalFaderThumbStyle" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="36" Height="20">
                        <!-- Diffuse Ambient Halo on Hover/Drag -->
                        <Border x:Name="CapGlow" Width="32" Height="17" CornerRadius="4" Background="{StaticResource AudioAccentBrush}" Opacity="0">
                            <Border.Effect>
                                <BlurEffect Radius="6" />
                            </Border.Effect>
                        </Border>
                        <!-- Tactile Console Fader Cap -->
                        <Border x:Name="FaderCap" Width="30" Height="15" CornerRadius="3" 
                                Background="{StaticResource EqualizerCapBackgroundBrush}"
                                BorderBrush="{StaticResource EqualizerCapBorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.55" />
                            </Border.Effect>
                            <!-- Luminous Center Index Notch -->
                            <Rectangle x:Name="IndexNotch" Width="20" Height="2" Fill="{StaticResource AudioAccentBrush}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" RadiusX="1" RadiusY="1">
                                <Rectangle.Effect>
                                    <DropShadowEffect Color="#A99AC8" BlurRadius="4" ShadowDepth="0" Opacity="0.8" />
                                </Rectangle.Effect>
                            </Rectangle>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FaderCap" Property="BorderBrush" Value="{StaticResource AudioAccentBrush}" />
                            <Setter TargetName="CapGlow" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="FaderCap" Property="Background" Value="#2A384F" />
                            <Setter TargetName="FaderCap" Property="BorderBrush" Value="{StaticResource AudioAccentBrush}" />
                            <Setter TargetName="CapGlow" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Alias for backward compatibility -->
    <Style x:Key="PrismVerticalSliderThumbStyle" TargetType="Thumb" BasedOn="{StaticResource PrismVerticalFaderThumbStyle}" />

    <!-- Vertical Spectral Equalizer Slider -->
    <Style x:Key="PrismVerticalFaderStyle" TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Width" Value="34" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PrismFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid HorizontalAlignment="Center">
                        <!-- Inactive Background Trough -->
                        <Border Width="12" CornerRadius="6" Background="{StaticResource EqualizerFaderTroughBrush}"
                                BorderBrush="{StaticResource EqualizerFaderBorderBrush}" BorderThickness="1" />

                        <!-- Center Unity Gain 0 dB Reference Hash Mark -->
                        <Rectangle Width="24" Height="1.5" Fill="{StaticResource EqualizerCenterLineBrush}" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" />

                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Width="10" CornerRadius="0,0,5,5" Background="{StaticResource EqualizerSpectralGradient}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PrismVerticalFaderThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Alias for backward compatibility -->
    <Style x:Key="PrismVerticalSliderStyle" TargetType="Slider" BasedOn="{StaticResource PrismVerticalFaderStyle}" />

    <!-- ================================================================= -->
    <!-- BUTTONS & INTERACTIVE CONTROLS                                    -->
    <!-- ================================================================= -->

    <!-- ================================================================= -->
    <!-- REFERENCE 3: PRISM REFRACTIVE GLASS BUTTONS                       -->
    <!-- ================================================================= -->

    <!-- Primary Liquid Glass Accent Button (Call-To-Action) -->
    <Style x:Key="PrismPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GlassPrimaryButtonGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassPrimaryButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="Foreground" Value="#080C14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PrismFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Layer 1: Ambient Teal Glow Shadow -->
                        <Border x:Name="ShadowLayer" CornerRadius="12" Margin="0,1,0,-1" Background="{StaticResource DisplayAccentBrush}" Opacity="0.25">
                            <Border.Effect>
                                <BlurEffect Radius="14" />
                            </Border.Effect>
                        </Border>
                        <!-- Layer 2: Glowing Cyan Glass Shell with Specular Rim -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Layer 3: Upper Specular Light Bevel Reflection -->
                                <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="3,1,3,0" CornerRadius="0.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                            <GradientStop Color="#80FFFFFF" Offset="0.3" />
                                            <GradientStop Color="#CCFFFFFF" Offset="0.5" />
                                            <GradientStop Color="#80FFFFFF" Offset="0.7" />
                                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <!-- Layer 4: Diagonal Refractive Sheen -->
                                <Border x:Name="DiagonalSheen" Opacity="0.25" CornerRadius="11" Margin="1" IsHitTestVisible="False"
                                        Background="{StaticResource GlassButtonDiagonalSheenBrush}" />
                                <!-- Layer 5: High-Contrast Foreground -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="0.7" />
                            <Setter TargetName="DiagonalSheen" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.98" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="0.2" />
                            <Setter TargetName="DiagonalSheen" Property="Opacity" Value="0.1" />
                            <Setter TargetName="Bd" Property="Margin" Value="0,1,0,-1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Translucent Liquid Glass Button -->
    <Style x:Key="PrismSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GlassButtonBackgroundGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PrismFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Layer 1: Ambient Contact Shadow -->
                        <Border x:Name="ShadowLayer" CornerRadius="10" Margin="0,1,0,-1" Background="#000000" Opacity="0.35">
                            <Border.Effect>
                                <BlurEffect Radius="8" />
                            </Border.Effect>
                        </Border>
                        <!-- Layer 2: Translucent Smoked Glass Body with Specular Bevel Rim -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Layer 3: Upper Specular Light Bevel Reflection -->
                                <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="3,1,3,0" CornerRadius="0.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                            <GradientStop Color="#40FFFFFF" Offset="0.3" />
                                            <GradientStop Color="#70FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#40FFFFFF" Offset="0.7" />
                                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <!-- Layer 4: Diagonal Refractive Sheen -->
                                <Border x:Name="DiagonalSheen" Opacity="0.18" CornerRadius="9" Margin="1" IsHitTestVisible="False"
                                        Background="{StaticResource GlassButtonDiagonalSheenBrush}" />
                                <!-- Layer 5: High-Contrast Foreground -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassButtonHoverGradient}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GlassButtonHoverBorderBrush}" />
                            <Setter TargetName="DiagonalSheen" Property="Opacity" Value="0.45" />
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassButtonPressedGradient}" />
                            <Setter TargetName="Bd" Property="Margin" Value="0,1,0,-1" />
                            <Setter TargetName="DiagonalSheen" Property="Opacity" Value="0.1" />
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="0.15" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liquid Glass Warning / Reset Action Button (Amber-Tinted) -->
    <Style x:Key="PrismWarningButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GlassWarningButtonGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassWarningButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="Foreground" Value="{StaticResource WarningAmberBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PrismFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ShadowLayer" CornerRadius="8" Background="#F59E0B" Opacity="0.15" Margin="0,1,0,-1">
                            <Border.Effect>
                                <BlurEffect Radius="8" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="2,1,2,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                            <GradientStop Color="#40F59E0B" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4DF59E0B" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WarningAmberBrush}" />
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26F59E0B" />
                            <Setter TargetName="Bd" Property="Margin" Value="0,1,0,-1" />
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="0.1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Circular / Square Glass Icon Button -->
    <Style x:Key="PrismIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GlassButtonBackgroundGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PrismFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ShadowLayer" CornerRadius="10" Background="#000000" Opacity="0.25" Margin="0,1,0,-1">
                            <Border.Effect>
                                <BlurEffect Radius="8" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <Grid>
                                <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="2,1,2,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                            <GradientStop Color="#50FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassButtonHoverGradient}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ElectricCyanBrush}" />
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassButtonPressedGradient}" />
                            <Setter TargetName="Bd" Property="Margin" Value="0,1,0,-1" />
                            <Setter TargetName="ShadowLayer" Property="Opacity" Value="0.1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass Toggle Switch -->
    <Style x:Key="PrismToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PrismFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Height="24" Width="44">
                        <Border x:Name="SwitchTrough" CornerRadius="12" 
                                Background="{StaticResource TrackInactiveBrush}" 
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" />
                        
                        <Ellipse x:Name="SwitchThumb" Width="18" Height="18" Margin="3,0,0,0" 
                                 HorizontalAlignment="Left" Fill="{StaticResource TextPrimaryBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.3" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrough" Property="Background" Value="{StaticResource DisplayAccentBrush}" />
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SwitchTrough" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status Badge (Capsule Chip) -->
    <Style x:Key="PrismStatusChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{StaticResource TrackInactiveBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Glass Dropdown ComboBox -->
    <Style x:Key="PrismComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="6" Margin="2,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrismHoverSheenBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3376C7C0" />
                            <Setter Property="Foreground" Value="{StaticResource DisplayAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="PrismComboBoxToggleButtonTemplate" TargetType="ToggleButton">
        <Border x:Name="Border" Background="{StaticResource SurfaceSecondaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="{StaticResource ChevronDownIconGeometry}" Fill="{StaticResource TextSecondaryBrush}"
                      Width="10" Height="6" Stretch="Uniform" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DisplayAccentBrush}" />
                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource DisplayAccentBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PrismComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PrismComboBoxItemStyle}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PrismFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource PrismComboBoxToggleButtonTemplate}"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" />
                        <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" PopupAnimation="Slide" Margin="1">
                            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Background="{StaticResource SurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.5" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global Dark Graphite ScrollBar Styles -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="6" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border x:Name="ThumbBorder" Background="#343E4C" CornerRadius="3" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#475569" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#64748B" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="6" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border x:Name="ThumbBorder" Background="#343E4C" CornerRadius="3" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#475569" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#64748B" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="PanningMode" Value="Both" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0"
                                   Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Margin="2,0,2,0" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1"
                                   Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Margin="0,2,0,2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!-- GLOBAL TOOLTIP STYLE (MIDNIGHT GRAPHITE THEME)                    -->
    <!-- ================================================================= -->
    <Style x:Key="PrismToolTipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource TooltipBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TooltipForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TooltipBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource PrismFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="MaxWidth" Value="550" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True"
                                          RecognizesAccessKey="False"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit Global Style applying to all ToolTips across PRISM -->
    <Style TargetType="ToolTip" BasedOn="{StaticResource PrismToolTipStyle}" />

    <!-- Compatibility Aliases -->
    <Style x:Key="PrismButtonStyle" BasedOn="{StaticResource PrismSecondaryButtonStyle}" TargetType="Button" />
    <Style x:Key="PrismToggleStyle" BasedOn="{StaticResource PrismToggleSwitchStyle}" TargetType="CheckBox" />

</ResourceDictionary>
