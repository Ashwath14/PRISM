<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- PRISM 2.0 — MIDNIGHT GRAPHITE DESIGN SYSTEM COLOR & MATERIAL TOKENS-->
    <!-- Muted Teal, Soft Lavender, Champagne, and Obsidian Graphite       -->
    <!-- ================================================================= -->

    <!-- Base Canvas / Window Surfaces (AppBackground: #0D1117) -->
    <Color x:Key="AppBackgroundColor">#0D1117</Color>
    <Color x:Key="PrismCanvasColor">#0D1117</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="PrismCanvasBrush" Color="{StaticResource PrismCanvasColor}" />
    <SolidColorBrush x:Key="WindowBaseBrush" Color="{StaticResource PrismCanvasColor}" />

    <!-- Primary Structural Panels / Sidebar (SurfacePrimary: #161B22) -->
    <Color x:Key="SurfacePrimaryColor">#161B22</Color>
    <Color x:Key="PrismSidebarColor">#161B22</Color>
    <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{StaticResource SurfacePrimaryColor}" />
    <SolidColorBrush x:Key="PrismSidebarBrush" Color="{StaticResource PrismSidebarColor}" />
    <SolidColorBrush x:Key="SidebarBaseBrush" Color="{StaticResource PrismSidebarColor}" />

    <!-- Secondary Cards & Module Surfaces (SurfaceSecondary: #1F2630) -->
    <Color x:Key="SurfaceSecondaryColor">#1F2630</Color>
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="CardBaseBrush" Color="{StaticResource SurfaceSecondaryColor}" />

    <!-- Elevated Floating Surfaces & Flyouts (SurfaceElevated: #2A3342) -->
    <Color x:Key="SurfaceElevatedColor">#2A3342</Color>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />

    <!-- Optical Glass Surfaces (Stratified Elevations) -->
    <!-- Level 1: Standard Card Glass (Smoked Graphite 75% opacity) -->
    <Color x:Key="PrismCardGlassColor">#D41F2630</Color>
    <SolidColorBrush x:Key="PrismCardGlassBrush" Color="{StaticResource PrismCardGlassColor}" />
    <SolidColorBrush x:Key="GlassCardBrush" Color="{StaticResource PrismCardGlassColor}" />

    <!-- Level 2: Elevated Surface / Popovers / Flyout (88% opacity) -->
    <Color x:Key="PrismElevatedGlassColor">#E62A3342</Color>
    <SolidColorBrush x:Key="PrismElevatedGlassBrush" Color="{StaticResource PrismElevatedGlassColor}" />
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="{StaticResource PrismElevatedGlassColor}" />
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#D9202A38" />

    <!-- Hover & Interactive Sheen -->
    <SolidColorBrush x:Key="PrismHoverSheenBrush" Color="#1AFFFFFF" /> <!-- 10% white -->
    <SolidColorBrush x:Key="GlassCardHoverBrush" Color="#2EFFFFFF" />  <!-- 18% white -->

    <!-- Glass Borders & Optical Edges (BorderSubtle: #343E4C) -->
    <Color x:Key="BorderSubtleColor">#343E4C</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="PrismBorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="GlassBorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="PrismBorderCardBrush" Color="#4D343E4C" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#4D343E4C" />
    <SolidColorBrush x:Key="PrismBorderInteractiveBrush" Color="#8076C7C0" /> <!-- Teal focus ring -->

    <!-- Semantic Domain Accents -->
    <!-- Display Domain (Muted Teal: #76C7C0) -->
    <Color x:Key="DisplayAccentColor">#76C7C0</Color>
    <Color x:Key="ElectricCyanColor">#76C7C0</Color>
    <SolidColorBrush x:Key="DisplayAccentBrush" Color="{StaticResource DisplayAccentColor}" />
    <SolidColorBrush x:Key="ElectricCyanBrush" Color="{StaticResource DisplayAccentColor}" />
    <SolidColorBrush x:Key="TealAccentBrush" Color="{StaticResource DisplayAccentColor}" />

    <Color x:Key="SapphireBlueColor">#5EA8A2</Color>
    <SolidColorBrush x:Key="SapphireBlueBrush" Color="{StaticResource SapphireBlueColor}" />

    <Color x:Key="IcyWhiteBlueColor">#E8F6F5</Color>
    <SolidColorBrush x:Key="IcyWhiteBlueBrush" Color="{StaticResource IcyWhiteBlueColor}" />

    <!-- Audio Domain (Soft Lavender: #A99AC8) -->
    <Color x:Key="AudioAccentColor">#A99AC8</Color>
    <SolidColorBrush x:Key="AudioAccentBrush" Color="{StaticResource AudioAccentColor}" />
    <SolidColorBrush x:Key="LavenderAccentBrush" Color="{StaticResource AudioAccentColor}" />

    <Color x:Key="DeepPurpleColor">#8F80B0</Color>
    <SolidColorBrush x:Key="DeepPurpleBrush" Color="{StaticResource DeepPurpleColor}" />

    <!-- Premium Highlight / Champagne Accent (#C6A77A) -->
    <Color x:Key="PremiumAccentColor">#C6A77A</Color>
    <SolidColorBrush x:Key="PremiumAccentBrush" Color="{StaticResource PremiumAccentColor}" />
    <SolidColorBrush x:Key="ChampagneAccentBrush" Color="{StaticResource PremiumAccentColor}" />

    <!-- Environment Accent (Harmonized Lavender/Teal) -->
    <Color x:Key="EnvironmentIndigoColor">#8E9EC5</Color>
    <SolidColorBrush x:Key="EnvironmentIndigoBrush" Color="{StaticResource EnvironmentIndigoColor}" />

    <!-- Status & Hardware Verification Badges -->
    <Color x:Key="SuccessGreenColor">#63C99A</Color>
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}" />
    <SolidColorBrush x:Key="SuccessGreenGlowBrush" Color="#3363C99A" />

    <Color x:Key="WarningAmberColor">#D6A76A</Color>
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmberColor}" />
    <SolidColorBrush x:Key="WarningAmberGlowBrush" Color="#33D6A76A" />

    <Color x:Key="ErrorRedColor">#E17D85</Color>
    <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRedColor}" />

    <Color x:Key="InactiveSlateColor">#8993A0</Color>
    <SolidColorBrush x:Key="InactiveSlateBrush" Color="{StaticResource InactiveSlateColor}" />

    <!-- Slider Troughs & Tracks -->
    <SolidColorBrush x:Key="TrackInactiveBrush" Color="#161B22" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#3376C7C0" />

    <!-- Sophisticated Linear & Radial Gradients (Midnight Graphite Edition) -->
    <LinearGradientBrush x:Key="CyanAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5EA8A2" Offset="0.0" />
        <GradientStop Color="#76C7C0" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DisplayAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5EA8A2" Offset="0.0" />
        <GradientStop Color="#76C7C0" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AudioAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8F80B0" Offset="0.0" />
        <GradientStop Color="#A99AC8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SliderTrackGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#5EA8A2" Offset="0.0" />
        <GradientStop Color="#76C7C0" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AudioSliderTrackGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8F80B0" Offset="0.0" />
        <GradientStop Color="#A99AC8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGlassGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC1F2630" Offset="0.0" />
        <GradientStop Color="#99161B22" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Deep Ambient Window Aurora Background (Subtle Violet/Teal Refraction) -->
    <RadialGradientBrush x:Key="WindowAmbientGlow" Center="0.5,0.15" RadiusX="0.85" RadiusY="0.6">
        <GradientStop Color="#1876C7C0" Offset="0.0" />
        <GradientStop Color="#10A99AC8" Offset="0.55" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </RadialGradientBrush>

    <!-- ================================================================= -->
    <!-- REFERENCE DESIGN SYSTEM TOKENS (GLASS BUTTON, LIQUID SLIDER, EQ)  -->
    <!-- ================================================================= -->

    <!-- Liquid Glass Slider Tokens -->
    <SolidColorBrush x:Key="LiquidGlassTrackBrush" Color="#161B22" />
    <SolidColorBrush x:Key="LiquidGlassTrackBorderBrush" Color="#343E4C" />
    
    <LinearGradientBrush x:Key="LiquidGlassThumbBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#F1F5F9" Offset="0.5" />
        <GradientStop Color="#E8E7E2" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidGlassThumbRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#6676C7C0" Offset="0.5" />
        <GradientStop Color="#335EA8A2" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidGlassAudioThumbRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#66A99AC8" Offset="0.5" />
        <GradientStop Color="#338F80B0" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Equalizer Spectral Fader Tokens -->
    <LinearGradientBrush x:Key="EqualizerSpectralGradient" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#161B22" Offset="0.0" />
        <GradientStop Color="#8F80B0" Offset="0.35" />
        <GradientStop Color="#A99AC8" Offset="0.75" />
        <GradientStop Color="#D4C8EB" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="EqualizerFaderTroughBrush" Color="#161B22" />
    <SolidColorBrush x:Key="EqualizerFaderBorderBrush" Color="#343E4C" />
    <SolidColorBrush x:Key="EqualizerCapBackgroundBrush" Color="#1F2630" />
    <SolidColorBrush x:Key="EqualizerCapBorderBrush" Color="#475569" />
    <SolidColorBrush x:Key="EqualizerCenterLineBrush" Color="#343E4C" />

    <!-- Glass Button & Material Tokens (Midnight Graphite Smoked Glass) -->
    <LinearGradientBrush x:Key="GlassButtonBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC1F2630" Offset="0.0" />
        <GradientStop Color="#99161B22" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassButtonHoverGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E62A3342" Offset="0.0" />
        <GradientStop Color="#B31F2630" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassButtonPressedGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3161B22" Offset="0.0" />
        <GradientStop Color="#800D1117" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassButtonBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80FFFFFF" Offset="0.0" />
        <GradientStop Color="#1AFFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassButtonHoverBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6FFFFFF" Offset="0.0" />
        <GradientStop Color="#6676C7C0" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Specular Internal Diagonal Sheen (Reflection Stripe) -->
    <LinearGradientBrush x:Key="GlassButtonDiagonalSheenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00FFFFFF" Offset="0.0" />
        <GradientStop Color="#00FFFFFF" Offset="0.35" />
        <GradientStop Color="#60FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="0.65" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassPrimaryButtonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#76C7C0" Offset="0.0" />
        <GradientStop Color="#5EA8A2" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassPrimaryButtonBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6FFFFFF" Offset="0.0" />
        <GradientStop Color="#6676C7C0" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassAudioButtonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A99AC8" Offset="0.0" />
        <GradientStop Color="#8F80B0" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassWarningButtonGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#33D6A76A" Offset="0.0" />
        <GradientStop Color="#1AD6A76A" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassWarningButtonBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80D6A76A" Offset="0.0" />
        <GradientStop Color="#33D6A76A" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Refined Glass Card & Container Materials -->
    <SolidColorBrush x:Key="PrismSurfaceBaseBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="PrismGlassCardBrush" Color="#D41F2630" />
    <SolidColorBrush x:Key="PrismGlassCardHoverBrush" Color="#F0242D3A" />
    <SolidColorBrush x:Key="PrismGlassCardBorderBrush" Color="#343E4C" />
    <SolidColorBrush x:Key="PrismGlassCardSelectedBorderBrush" Color="#8076C7C0" />
    <SolidColorBrush x:Key="PrismGlassCardAudioSelectedBorderBrush" Color="#80A99AC8" />

    <!-- Sharp, High-Contrast Midnight Graphite Typography Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8E7E2" />   <!-- Main Text (Warm Crisp Off-White) -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B9C0CA" /> <!-- Secondary Technical Text -->
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8993A0" />  <!-- Metadata & Register Specs -->
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8993A0" />     <!-- Metadata / Muted -->
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5A6472" />  <!-- Disabled -->

    <!-- Global Typography Tokens -->
    <FontFamily x:Key="PrismFontFamily">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>

    <!-- Global Tooltip Design Tokens (Midnight Graphite Specification) -->
    <Color x:Key="TooltipBackgroundColor">#202A38</Color>
    <Color x:Key="TooltipBorderColor">#343E4C</Color>
    <Color x:Key="TooltipForegroundColor">#E8E7E2</Color>
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{StaticResource TooltipBackgroundColor}" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{StaticResource TooltipBorderColor}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{StaticResource TooltipForegroundColor}" />


</ResourceDictionary>